# nak-base MVP 環境設定

# PostgreSQL Settings
POSTGRES_USER=nakbase
POSTGRES_PASSWORD=nakbase_secret
POSTGRES_DB=nakbase

# API Security
SECRET_KEY=your-secret-key-change-in-production

# ==========================================
# Application Modes
# ==========================================
# デバッグモード (ログ出力の増加やデバッガのアタッチなど)
DEBUG_MODE=true

# モックモード (LLM推論をスキップして固定値を返すか)
MOCK_MODE=true
