# nak-base MVP 環境設定

# PostgreSQL Settings
POSTGRES_USER=nakbase
POSTGRES_PASSWORD=nakbase_secret
POSTGRES_DB=nakbase

# API Security
SECRET_KEY=your-secret-key-change-in-production

# ==========================================
# Application Modes
# ==========================================
# デバッグモード (ログ出力の増加やデバッガのアタッチなど)
DEBUG_MODE=true

# モックモード (LLM推論をスキップして固定値を返すか)
MOCK_MODE=true

# ==========================================
# Application Modes
# ==========================================
# デバッグモード (ログ出力の増加やデバッガのアタッチなど)
DEBUG_MODE=true

# モックモード (LLM推論をスキップして固定値を返すか)
MOCK_MODE=False

# ==========================================
# Multi-Agent Pipeline (Phase 2)
# ==========================================
# 使用するLLMプロバイダ: gemini または openai
LLM_PROVIDER=openai

# --- Gemini ---
# 直接環境変数で渡すか、./secrets/gemini_api_key にキーのみを保存
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=/secrets/gemini_api_key
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

# --- OpenAI / GPT ---
# 直接環境変数で渡すか、./secrets/openai_api_key にキーのみを保存
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=/secrets/openai_api_key
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_PRO=gpt-4o

# エージェント並列実行 / タイムアウト
AGENTS_PARALLEL=true
AGENT_TIMEOUT=300